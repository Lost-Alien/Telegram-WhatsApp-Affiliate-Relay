# Required: application credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Required: comma-separated source @usernames, channel URLs or joined -100 IDs.
# Example: @your_deals_channel,@another_source
TELEGRAM_SOURCE_CHANNELS=

# Required: your WhatsApp channel JID, ending in @newsletter.
# The linked WhatsApp account must administer that channel.
WHATSAPP_TARGET_JID=

# Required: your own Amazon Associates store tag.
AMAZON_AFFILIATE_TAG=
AMAZON_DOMAIN=amazon.in

# Set your own Cuelinks channel ID to convert Flipkart and supported merchants.
# Leave blank for Amazon-only use. The API key is optional for direct tracking URLs.
CUELINKS_CHANNEL_ID=
CUELINKS_API_KEY=
CUELINKS_SUBID=tgwarelay

# Optional invitation URL to append to forwarded posts.
FOOTER_URL=

# The dashboard has no password. Change HOST only for your intended network access.
HOST=127.0.0.1
PORT=3100
DATA_DIR=.data
MAX_MEDIA_MIB=8
MAX_QUEUED_POSTS=1000
LOG_LEVEL=info
